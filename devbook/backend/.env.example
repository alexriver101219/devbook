# Valores para desarrollo local; no copies DB_HOST=localhost a Vercel.
# En Vercel usa la dirección pública de un MySQL administrado o alojado en un servidor,
# con acceso de red restringido y TLS cuando lo requiera el proveedor.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=devbook_db
PORT=5000
APP_ORIGIN=http://localhost:8085
APP_BASE_URL=http://localhost:8085
SESSION_SECRET=generate_a_random_secret_at_least_32_bytes
# Use a seller test access token here; never commit a real token.
MP_ACCESS_TOKEN=
MP_USE_SANDBOX=true
